theorem codes_exact : codes = heroes.flatMap (fun hero => allDirs.filterMap (code hero)) := by decide +kernel

theorem code_coverage : ∀ hero ∈ heroes, ∀ dir a, code hero dir = some a → a ∈ codes := by
  intro hero member dir a found
  rw [codes_exact]
  exact List.mem_flatMap.mpr ⟨hero,member,List.mem_filterMap.mpr ⟨dir,Geometry.all_directions dir,found⟩⟩
theorem targets_checked : codes.all (fun a => heroes.contains a.target) = true := by decide +kernel
theorem code_targets : ∀ a ∈ codes, a.target ∈ heroes := by
  intro a member
  exact List.contains_iff_mem.mp (List.all_eq_true.mp targets_checked a member)

def fastCheck (table : IndexedCertificateTable.Table Row) (_ : Nat) (r : Row) : Bool :=
  if r.value = 0 then true else fastWalkCheck codes r && pushCheck actions table r &&
    decide (r.boxes.length ≤ 4 → Int.ofNat r.value ≤ debt r.boxes)

theorem fastCheck_implies (table : IndexedCertificateTable.Table Row) (i : Nat) (r : Row)
    (checked : fastCheck table i r = true) : check heroes actions table i r = true := by
  by_cases zero : r.value = 0
  · simp [check,zero]
  simp only [fastCheck,if_neg zero,Bool.and_eq_true_iff] at checked
  simp only [check,if_neg zero,Bool.and_eq_true_iff]
  exact ⟨⟨fast_implies_walk heroes codes code_coverage code_targets r checked.1.1,checked.1.2⟩,checked.2⟩
end NetHack.Soko32Penalty5
