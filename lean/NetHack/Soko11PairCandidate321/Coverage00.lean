def coverageCheck00 : Bool :=
  (NetHack.Soko11Hero315.phases.crates 0).all fun a =>
    (NetHack.Soko11Hero315.phases.crates 0).all fun b =>
      decide (a = b ∨ lookup table00 (code [a,b]) = 0 ∨ [a,b] ∈ positivePairs00 ∨ [b,a] ∈ positivePairs00)
theorem checked_coverage00 : coverageCheck00 = true := by decide +kernel

theorem covered_positive00 (hero : Cell) (group : List Cell) (unique : group.Nodup)
    (inside : group ⊆ NetHack.Soko11Hero315.phases.crates 0) (positive : 0 < bonus 0 hero group) :
    ∃ pair ∈ positivePairs00, group.Perm pair := by
  have two : group.length = 2 := by
    by_cases h : group.length = 2
    · exact h
    · simp [bonus,h] at positive
  cases group with
  | nil => simp at two
  | cons a tail =>
    cases tail with
    | nil => simp at two
    | cons b rest =>
      cases rest with
      | nil =>
        have different : a ≠ b := by simpa using (List.nodup_cons.mp unique).1
        have all := checked_coverage00
        unfold coverageCheck00 at all
        have x := List.all_eq_true.mp (List.all_eq_true.mp all a (inside (by simp))) b (inside (by simp))
        have choices := of_decide_eq_true x
        rcases choices with same|zero|forward|backward
        · exact False.elim (different same)
        · have impossible : bonus 0 hero [a,b] = 0 := by simp [bonus,tables,zero]
          rw [impossible] at positive
          omega
        · exact ⟨[a,b],forward,List.Perm.refl _⟩
        · exact ⟨[b,a],backward,List.Perm.swap b a []⟩
      | cons c rest => simp only [List.length_cons] at two; omega
