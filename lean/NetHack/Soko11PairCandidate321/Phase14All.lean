theorem all_positive_actions14 : PositiveActionsAt 14 := by
  intro hero heroInside group unique inside length floor door hole clear positive direction outcome oracle
  rcases covered_positive14 hero group unique inside positive with ⟨pair,member,related⟩
  have checked := List.all_eq_true.mp all_rows14 pair member
  have projection : PatternCorrection.project group = PatternCorrection.project pair :=
    funext fun _ => related.contains_eq
  have other : stepOracle soko1_1.board (PatternCorrection.project pair)
      (PatternCorrection.project (soko1_1.initial.holes.drop 14)) hero direction = some outcome := by
    rw [←projection]
    exact oracle
  exact (localBound_respects 14 hero group pair related outcome).mpr
    (rowCheck_actions 14 pair checked hero heroInside direction outcome other)
theorem all_positive_environments14 : PositiveEnvironmentsAt 14 := by
  intro hero heroInside group unique inside nextInside length floor door hole clear positive
  rcases covered_positive14 hero group unique inside positive with ⟨pair,member,related⟩
  have checked := List.all_eq_true.mp all_rows14 pair member
  have otherClear : hero ∉ pair := fun h => clear (related.mem_iff.mpr h)
  rw [valueAt_respects 14 hero group pair related,valueAt_respects 15 hero group pair related]
  exact rowCheck_environment 14 pair checked hero heroInside otherClear (by decide)
