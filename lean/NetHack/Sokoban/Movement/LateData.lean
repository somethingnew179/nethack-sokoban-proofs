quotient or trusted external BFS is used by the kernel proof. -/
import NetHack.Sokoban.Movement.Bounded
import NetHack.Sokoban.Movement.Paths85x322
import NetHack.Sokoban.Soko42Optimal
import NetHack.Sokoban.Reduction
set_option maxRecDepth 100000
set_option maxHeartbeats 3000000
namespace NetHack.Sokoban.Movement.Late

def initial : State := {player := 128, boulders := [127, 20, 51], holes := [31]}
def prefixTail : List Dir := [.east, .east, .east, .east, .east, .northEast, .northWest, .south, .southEast, .west]
theorem prefixTail_checked : run soko4_2.board Paths85x322.state304 prefixTail =
    some ⟨initial, 2, 10⟩ := by decide

def initialPath : List Dir := Paths85x322.prefix18 ++ prefixTail

theorem prefix_checked : run soko4_2.board soko4_2.initial initialPath = some ⟨initial,83,314⟩ :=
  run_append_of soko4_2.board soko4_2.initial Paths85x322.prefix18 prefixTail
    ⟨Paths85x322.state304,81,304⟩
    ⟨initial,2,10⟩
    Paths85x322.prefix18_checked prefixTail_checked

theorem reachable : Trace soko4_2.board soko4_2.initial initialPath initial 83 314 :=
  run_sound _ _ _ _ prefix_checked

def suffix : List Dir := [.west, .west, .west, .west, .west, .west, .southWest, .north]
theorem suffix_checked : run soko4_2.board initial suffix = some ⟨Paths85x322.finalState,2,8⟩ := by decide

theorem winning : Trace soko4_2.board initial suffix Paths85x322.finalState 2 8 :=
  run_sound _ _ _ _ suffix_checked

