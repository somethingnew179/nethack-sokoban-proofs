theorem reverse_checked : Geometry.reverseCheck soko2_1.board = true := by
  change soko2_1.board.floor.all reverseRow = true
  exact List.all_eq_true.mpr reverse_rows
theorem reverse (player : Cell) (playerFloor : player ∈ soko2_1.board.floor)
    (direction : Dir) (source : Cell)
    (adjacent : advance soko2_1.board player direction = some source) :
    advance soko2_1.board source direction.opposite = some player :=
  Geometry.reverseCheck_sound soko2_1.board reverse_checked player playerFloor direction source adjacent
theorem checkedDirs_complete (direction : Dir) : direction ∈ checkedDirs := by
  cases direction <;> simp [checkedDirs]
theorem source_order_eq : sourceOrder = soko2_1.board.floor := by rfl
theorem source_order (source : Cell) (member : source ∈ soko2_1.board.floor) : source ∈ sourceOrder := by
  simpa only [source_order_eq] using member
theorem source_order_checked : soko2_1.board.floor.all sourceOrder.contains = true := by
  exact List.all_eq_true.mpr (fun source member => List.contains_iff_mem.mpr (source_order source member))
