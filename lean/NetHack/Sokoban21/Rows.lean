def relaxedBlocked (pattern : Twelve) (cell : Cell) : Bool :=
  (!soko2_1.board.floor.contains cell && !soko2_1.board.doors.contains cell) || known pattern cell
def relaxedSide (pattern : Twelve) (player : Cell) (direction : Dir) : Bool :=
  match advance soko2_1.board player direction with
  | none => true
  | some cell => relaxedBlocked pattern cell
def relaxedCorner (pattern : Twelve) (player : Cell) (direction : Dir) : Bool :=
  direction.diagonal && relaxedSide pattern player direction.sides.1 && relaxedSide pattern player direction.sides.2
def walkGuard (edge : WalkEdge) (dead : Nat) (pattern : Twelve) : Bool :=
  budgetGuard dead pattern && !known pattern edge.player && !known pattern edge.target &&
    !relaxedCorner pattern edge.player edge.direction
def pushGuard (edge : PushEdge) (dead : Nat) (pattern : Twelve) : Bool :=
  budgetGuard dead pattern && !known pattern edge.player &&
    (!support.contains edge.source || known pattern edge.source) && !known pattern edge.first &&
    (!known pattern edge.landing || decide (edge.landing = edge.source)) &&
    (!edge.sourceDead || decide (0 < dead))
def nextDead (edge : PushEdge) (dead : Nat) : Nat :=
  dead - edge.sourceDead.toNat + edge.landingDead.toNat
def WalkBound (edge : WalkEdge) (dead : Nat) : Prop := ∀ pattern,
  walkGuard edge dead pattern = true → bonus dead edge.player pattern ≤ bonus dead edge.target pattern
def PushBound (edge : PushEdge) (dead : Nat) : Prop := ∀ pattern,
  pushGuard edge dead pattern = true → bonus dead edge.player pattern ≤ edge.moveSlack +
    bonus (nextDead edge dead) edge.source (change pattern (index edge.source) (index edge.landing))
def ConsumeBound (edge : PushEdge) (dead : Nat) : Prop := ∀ pattern,
  pushGuard edge dead pattern = true → bonus dead edge.player pattern ≤ edge.consumeSlack +
    bonus dead edge.source (change pattern (index edge.source) 12)
def checkedDirs : List Dir := [.north,.east,.south,.west,.northEast,.southEast,.southWest,.northWest]
def sourceOrder : List Cell := [21, 22, 23, 24, 25, 26, 27, 28, 30, 31, 32, 34, 35, 36, 37, 38, 41, 42, 43, 44, 45, 47, 48, 50, 52, 54, 55, 56, 57, 58, 61, 62, 64, 65, 66, 67, 68, 70, 71, 72, 74, 75, 76, 77, 78, 82, 84, 85, 87, 88, 90, 92, 94, 95, 96, 97, 98, 101, 102, 103, 106, 107, 108, 109, 110, 111, 112, 114, 115, 116, 117, 118, 121, 122, 123, 125, 126, 127, 129, 130, 131, 134, 135, 136, 137, 138, 141, 142, 143, 145, 146, 148, 149, 150, 154, 155, 156, 157, 158, 162, 163, 165, 166, 181, 182, 183, 184, 185, 186, 187, 188, 189, 190, 191, 192, 193, 194, 195, 196, 197, 198, 201, 202, 203, 205, 206]
def computedWalks : List WalkEdge := soko2_1.board.floor.flatMap fun player => checkedDirs.flatMap fun direction =>
  match advance soko2_1.board player direction with
  | none => []
  | some target => if soko2_1.board.floor.contains target then [⟨player,target,direction⟩] else []
def computedPushEdge (source : Cell) (direction : Dir) (landing : Cell) : PushEdge :=
  ⟨source, (advance soko2_1.board source direction.opposite).getD 0,
    (advance soko2_1.board source direction).getD 0, landing, direction,
    1 + Generated.soko2_1Potential.boulder landing - Generated.soko2_1Potential.boulder source,
    1 - Generated.soko2_1Potential.boulder source - Generated.soko2_1Potential.hole landing,
    deadCells.contains source, deadCells.contains landing⟩
def computedPushes : List PushEdge := sourceOrder.flatMap fun source => checkedDirs.flatMap fun direction =>
  (pushTargets soko2_1.board source direction).map (computedPushEdge source direction)
def pushFacts (edge : PushEdge) : Bool := decide (
  advance soko2_1.board edge.player edge.direction = some edge.source ∧
  advance soko2_1.board edge.source edge.direction = some edge.first ∧
  edge.moveSlack = 1 + Generated.soko2_1Potential.boulder edge.landing - Generated.soko2_1Potential.boulder edge.source ∧
  edge.consumeSlack = 1 - Generated.soko2_1Potential.boulder edge.source - Generated.soko2_1Potential.hole edge.landing ∧
  edge.sourceDead = deadCells.contains edge.source ∧ edge.landingDead = deadCells.contains edge.landing)
end NetHack.Sokoban21
