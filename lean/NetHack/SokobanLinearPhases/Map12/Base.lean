def walkRow (phase : Nat) (hero : Cell) : Bool := allDirs.all fun direction =>
  match advance soko1_2.board hero direction with
  | none => true
  | some target => !soko1_2.board.floor.contains target || (soko1_2.initial.holes.drop phase).contains target || (heroes phase).contains target
def pushRow (phase : Nat) (source : Cell) : Bool := allDirs.all fun direction =>
  match HazardPattern.pushOracle soko1_2.board emptyBoxes (PatternCorrection.project (soko1_2.initial.holes.drop phase)) source direction with
  | none => true
  | some (.stay landing) => (heroes phase).contains source && (crates phase).contains landing
  | some (.fill hole) => (heroes (phase+1)).contains source && decide ((soko1_2.initial.holes.drop phase).erase hole = soko1_2.initial.holes.drop (phase+1)) && decide (crates phase ⊆ crates (phase+1))
