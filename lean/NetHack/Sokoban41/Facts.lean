theorem push_facts (edge : PushEdge) (member : edge ∈ pushEdges) :
    advance soko4_1.board edge.player edge.direction = some edge.source ∧
    advance soko4_1.board edge.source edge.direction = some edge.first ∧
    edge.moveSlack = 1 + Generated.soko4_1Potential.boulder edge.landing - Generated.soko4_1Potential.boulder edge.source ∧
    edge.consumeSlack = 1 - Generated.soko4_1Potential.boulder edge.source - Generated.soko4_1Potential.hole edge.landing ∧
    edge.sourceDead = deadCells.contains edge.source ∧ edge.landingDead = deadCells.contains edge.landing :=
  of_decide_eq_true (all_push_facts edge member)
