theorem walk_bounds (edge : WalkEdge) (member : edge ∈ walkEdges) (dead : Nat) (limited : dead ≤ 1) :
    WalkBound edge dead := by
  have cases : dead = 0 ∨ dead = 1 := by omega
  rcases cases with rfl | rfl
  · exact all_walk0 edge member
  · exact all_walk1 edge member
theorem push_bounds (edge : PushEdge) (member : edge ∈ pushEdges) (dead : Nat) (limited : dead ≤ 1) :
    PushBound edge dead := by
  have cases : dead = 0 ∨ dead = 1 := by omega
  rcases cases with rfl | rfl
  · exact all_push0 edge member
  · exact all_push1 edge member
theorem consume_bounds (edge : PushEdge) (member : edge ∈ pushEdges) (dead : Nat) (limited : dead ≤ 1)
    (original : edge.landing ∈ soko4_1.initial.holes) (live : edge.sourceDead = false) :
    ConsumeBound edge dead := by
  have cases : dead = 0 ∨ dead = 1 := by omega
  rcases cases with rfl | rfl
  · exact all_consume0 edge member original live
  · exact all_consume1 edge member original live
