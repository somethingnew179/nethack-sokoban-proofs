theorem matrix_rows : ∀ i, matrixNode i=true := by
  intro i
  obtain ⟨v,bound⟩ := i
  have choices : v=0∨v=1∨v=2∨v=3∨v=4∨v=5∨v=6∨v=7∨v=8∨v=9∨v=10∨v=11∨v=12∨v=13∨v=14 := by omega
  rcases choices with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl
  · exact row0
